{
  "name": "formulino",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend",
    "cli"
  ],
  "engines": {
    "node": ">=24.15 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend && npm run build -w cli",
    "test": "npm run test -w backend && npm run test -w frontend && npm run test -w cli",
    "lint": "npm run lint -w backend && npm run lint -w frontend && npm run lint -w cli",
    "hooks:install": "pre-commit install",
    "hooks:run": "pre-commit run --all-files",
    "format": "prettier --write \"**/*.{ts,js,cjs,mjs,json,md,yml,yaml,html,css}\"",
    "format:check": "prettier --check \"**/*.{ts,js,cjs,mjs,json,md,yml,yaml,html,css}\""
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.2",
    "jest": "^30.5.2",
    "prettier": "^3.5.3",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
